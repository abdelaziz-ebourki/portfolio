{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/portfolio-manifest-v1.json",
  "title": "Portfolio project manifest (.portfolio.json)",
  "description": "Authored per project repo at .portfolio.json. Mirrors the UI ProjectDto contract (ui/src/lib/project-dto.ts); cover.path is repo-relative and resolved to an absolute URL by the API at serve time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "tagline",
    "status",
    "role",
    "kind",
    "period",
    "stack",
    "repos",
    "links",
    "highlights"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "$ref": "#/$defs/localizedText" },
    "tagline": { "$ref": "#/$defs/localizedText" },
    "status": {
      "type": "string",
      "enum": ["shipped", "in-progress", "maintained", "archived"]
    },
    "role": {
      "type": "string",
      "enum": ["solo", "team"]
    },
    "teamSize": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["personal", "academic", "client", "oss"]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "end": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" }
      }
    },
    "stack": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demo": { "type": "string", "format": "uri" },
        "docs": { "type": "string", "format": "uri" },
        "design": { "type": "string", "format": "uri" },
        "video": { "type": "string", "format": "uri" }
      }
    },
    "highlights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "fr": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ar": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "$ref": "#/$defs/localizedText" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative asset path (e.g. docs/cover.png). Never a URL, never absolute, never escaping the repo.",
          "pattern": "^(?!https?://)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "alt": { "$ref": "#/$defs/localizedText" },
        "kind": {
          "type": "string",
          "enum": ["image", "gif", "video"]
        }
      }
    },
    "featured": { "type": "boolean" },
    "displayOrder": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string" },
        "ar": { "type": "string" }
      }
    }
  }
}
