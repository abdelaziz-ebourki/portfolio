# Local defaults — copy to .env and adjust. Never commit .env.
# API port. NOTE: 8080/8081 are taken by other local projects,
# so override with API_PORT=8082 (or free) when starting the stack.
API_PORT=8080

# Where the UI finds the API (browser-side; use the host port above).
VITE_API_URL=http://localhost:8080

# Comma-separated CORS origin patterns. Wildcard port covers Vite's
# auto-increment when 5173 is taken by another project.
CORS_ALLOWED_ORIGINS=http://localhost:*

# Postgres (compose service `db`).
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_PORT=5432

# GitHub sync. Blank = fail-closed (webhooks rejected, admin sync disabled).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
ADMIN_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
