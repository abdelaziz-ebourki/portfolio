# Local defaults — copy to .env and adjust. Never commit .env.
# HOST port for the API (compose maps API_PORT -> container 8080, which is
# fixed). NOTE: 8080/8081 are taken by other local projects on this machine,
# so override with API_PORT=8082 (or free) when starting the stack.
API_PORT=8080

# Where the UI finds the API. Empty = same-origin /api (nginx proxy in
# prod, vite dev-proxy locally). Set an absolute URL only to bypass both.
VITE_API_URL=

# Host port for the production UI service (nginx).
UI_PORT=8083

# Comma-separated CORS origin patterns (spaces allowed). Wildcard port covers
# Vite's auto-increment when 5173 is taken by another project. Passed to the
# api container; without it the backend default (same value) applies.
CORS_ALLOWED_ORIGINS=http://localhost:*

# Postgres (compose service `db`).
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_PORT=5432

# GitHub sync. Blank = fail-closed (webhooks rejected, admin sync disabled).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
ADMIN_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
